{
  "type": "object",
  "required": [
    "task_id",
    "claim_key",
    "status",
    "worktree",
    "branch",
    "base_commit",
    "commits",
    "changed_files",
    "tests",
    "self_check",
    "deviations",
    "resources",
    "blockers",
    "coverage_note"
  ],
  "additionalProperties": false,
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^T[0-9]{2}$"
    },
    "claim_key": {
      "type": "string",
      "minLength": 1
    },
    "worktree": {
      "type": "string",
      "minLength": 1
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "coverage_note": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "ready",
        "blocked"
      ]
    },
    "base_commit": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "deviations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "commits": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "command",
          "phase",
          "exit_code",
          "evidence_path"
        ],
        "additionalProperties": false,
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "phase": {
            "type": "string",
            "enum": [
              "baseline",
              "red",
              "green",
              "integration"
            ]
          },
          "exit_code": {
            "type": "number"
          },
          "evidence_path": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "self_check": {
      "type": "object",
      "required": [
        "over_under_building",
        "contract_alignment"
      ],
      "additionalProperties": false,
      "properties": {
        "over_under_building": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "unverified"
          ]
        },
        "contract_alignment": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "unverified"
          ]
        }
      }
    }
  },
  "if": {
    "type": "object",
    "required": [
      "status"
    ],
    "properties": {
      "status": {
        "const": "ready"
      }
    }
  },
  "then": {
    "type": "object",
    "properties": {
      "commits": {
        "type": "array",
        "minItems": 1
      },
      "tests": {
        "type": "array",
        "minItems": 2
      },
      "blockers": {
        "type": "array",
        "maxItems": 0
      },
      "self_check": {
        "type": "object",
        "properties": {
          "over_under_building": {
            "const": "pass"
          },
          "contract_alignment": {
            "const": "pass"
          }
        }
      }
    }
  },
  "else": {
    "type": "object",
    "properties": {
      "blockers": {
        "type": "array",
        "minItems": 1
      }
    }
  }
}
