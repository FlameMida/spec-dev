{
  "type": "object",
  "required": [
    "items",
    "coverage_note"
  ],
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "check",
          "dimension",
          "tier",
          "ops",
          "result",
          "evidence_ref",
          "expected",
          "observed",
          "required"
        ],
        "properties": {
          "check": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "dimension": {
            "type": "string",
            "enum": [
              "unit",
              "integration",
              "e2e",
              "visual",
              "a11y",
              "perf-web",
              "perf-api",
              "other"
            ]
          },
          "tier": {
            "type": "string",
            "enum": [
              "D",
              "A",
              "X"
            ]
          },
          "requirement_ref": {
            "type": "string"
          },
          "ops": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "result": {
            "type": "string",
            "enum": [
              "pass",
              "warn",
              "fail",
              "unverified"
            ]
          },
          "evidence_ref": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "recheck": {
            "type": "object",
            "required": [
              "status",
              "evidence_ref",
              "evidence_sha256"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "维持",
                  "降级",
                  "翻案"
                ]
              },
              "evidence_ref": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "evidence_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "expected": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "observed": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "required": {
            "type": "boolean"
          },
          "evidence_sha256": {
            "type": "string"
          }
        },
        "if": {
          "type": "object",
          "required": [
            "result"
          ],
          "properties": {
            "result": {
              "enum": [
                "pass",
                "fail",
                "warn"
              ]
            }
          }
        },
        "then": {
          "type": "object",
          "required": [
            "evidence_ref",
            "evidence_sha256"
          ],
          "properties": {
            "evidence_ref": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "evidence_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      }
    },
    "coverage_note": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    }
  }
}
