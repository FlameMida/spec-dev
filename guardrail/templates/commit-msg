#!/usr/bin/env sh
legacy_dir="$(git rev-parse --git-common-dir)/hooks"
self_dir="$(cd "$(dirname "$0")" && pwd)"
if [ -x "$legacy_dir/commit-msg" ] && [ "$(cd "$legacy_dir" 2>/dev/null && pwd)" != "$self_dir" ]; then
  "$legacy_dir/commit-msg" "$@" || exit $?
fi
# spec-dev:guard:start
spec_dev_binding="$(git rev-parse --show-toplevel)/scripts/spec-dev/task-binding.mjs"
node "$spec_dev_binding" check-message --file "$1" || exit $?
# spec-dev:guard:end
exit 0
